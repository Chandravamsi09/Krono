      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@krono/raft": {
      "resolved": "packages/raft",
      "link": true
    },
    "node_modules/@krono/scheduler": {
      "resolved": "packages/scheduler",
      "link": true
    },
    "node_modules/@krono/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/@krono/worker": {
      "resolved": "packages/worker",
