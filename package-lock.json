{
  "name": "krono-platform",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "krono-platform",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "node_modules/@krono/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@krono/lsm": {
      "resolved": "packages/lsm",
      "link": true
    },
    "node_modules/@krono/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@krono/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "packages/core": {
      "name": "@krono/core",
      "version": "1.0.0"
    },
    "packages/lsm": {
      "name": "@krono/lsm",
      "version": "1.0.0",
      "dependencies": {
        "@krono/core": "*",
        "@krono/storage": "*"
      }
    },
    "packages/protocol": {
      "name": "@krono/protocol",
      "version": "1.0.0",
      "dependencies": {
        "@krono/core": "*"
      }
    },
    "packages/storage": {
      "name": "@krono/storage",
      "version": "1.0.0",
      "dependencies": {
        "@krono/core": "*",
        "@krono/protocol": "*"
      }
    }
  }
}
